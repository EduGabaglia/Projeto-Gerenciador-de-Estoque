# URL base da API, sem o sufixo /api.
#
# Em dispositivo físico, use o IP da máquina na mesma rede Wi-Fi:
#   EXPO_PUBLIC_API_URL=http://192.168.0.10:5080
#
# No emulador Android, 10.0.2.2 aponta para o localhost do computador:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:5080
#
# No simulador iOS ou no navegador, localhost funciona:
#   EXPO_PUBLIC_API_URL=http://localhost:5080
#
# A API de produção deve usar HTTPS.
EXPO_PUBLIC_API_URL=http://192.168.0.10:5080
