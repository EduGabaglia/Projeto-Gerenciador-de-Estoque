@model projeto_estoque_web.Models.view_models.MovimentoEstoqueViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-group">
    <label asp-for="ProdutoId"></label>
    <select asp-for="ProdutoId" asp-items="@(ViewBag.Produtos as SelectList)" class="form-control">
        <option value="">Selecione um produto</option>
    </select>
    <span asp-validation-for="ProdutoId" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Quantidade"></label>
    <input asp-for="Quantidade" class="form-control" type="number" min="1" step="1" placeholder="Quantidade" />
    <span asp-validation-for="Quantidade" class="text-danger"></span>
</div>

<div class="form-actions">
    <button type="submit" class="btn-salvar">
        Salvar
    </button>

    <a asp-action="Index" class="btn-cancelar">
        Cancelar
    </a>
</div>