@model projeto_estoque_web.Models.view_models.MovimentoEstoqueViewModel

@{
    ViewData["Title"] = "Saída de estoque";
}

@section Styles {
    <link rel="stylesheet" href="~/css/estoque.css" asp-append-version="true" />
}

<div class="estoque">

    <div class="estoque-header">
        <div>
            <h1>Saída de estoque</h1>
            <p>Registre a saída de produtos do estoque</p>
        </div>
    </div>

    <partial name="_Navegacao" />

    <form asp-action="Saida" method="post">

        <div class="estoque-panel">
            <partial name="_MovimentoForm" model="Model" />
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}