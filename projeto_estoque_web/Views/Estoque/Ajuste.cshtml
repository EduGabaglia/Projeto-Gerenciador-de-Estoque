@model projeto_estoque_web.Models.view_models.AjusteEstoqueViewModel

@{
    ViewData["Title"] = "Ajuste de estoque";
}

@section Styles {
    <link rel="stylesheet" href="~/css/estoque.css" asp-append-version="true" />
}

<div class="estoque">

    <div class="estoque-header">
        <div>
            <h1>Ajuste de estoque</h1>
            <p>Corrija a quantidade do produto no estoque</p>
        </div>
    </div>

    <partial name="_Navegacao" />

    <form asp-action="Ajuste" method="post">

        <div class="estoque-panel">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ProdutoId"></label>
                <select asp-for="ProdutoId" asp-items="@(ViewBag.Produtos as SelectList)" class="form-control">
                    <option value="">Selecione um produto</option>
                </select>
                <span asp-validation-for="ProdutoId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NovaQuantidade"></label>
                <input asp-for="NovaQuantidade" class="form-control" type="number" min="0" step="1" placeholder="Nova quantidade" />
                <span asp-validation-for="NovaQuantidade" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-salvar">
                    Salvar
                </button>

                <a asp-action="Index" class="btn-cancelar">
                    Cancelar
                </a>
            </div>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}