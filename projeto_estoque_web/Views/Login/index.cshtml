@model projeto_estoque_web.Models.view_models.LoginViewModel
@section Styles {
    <link rel= "stylesheet" href= "~/css/login.css" asp-append-version="true"/>
}
<main class = "login-container">
    <div class="decoracao-caixa">
      <span></span>
    </div>
    <div class="decoracao-caixa caixa-2">
      <span></span>
    </div>
    <div class="decoracao-prancheta"></div>
    <div class="decoracao-prancheta prancheta-2"></div>
    <section class= "login-card"> 
        <h1>Login</h1>
        <p>
          Informe seu usuário e senha para acessar o sistema.
        </p>
        <form asp-controller="Login" asp-action="Index" method="post">
            @Html.ValidationSummary()
            <label for = "usuario">Usuário</label>
            <div class="input-wrapper">
              <span class="input-icon">
                <i class="bi bi-person-fill"></i>
              </span>
              <input asp-for = "Usuario" placeholder="Digite seu usuário.."required>
            </div>
            <label for = "senha">Senha</label>
            <div class="input-wrapper">
              <span class="input-icon">
                  <i class="bi bi-lock-fill"></i>
              </span>
              <input asp-for = "Senha" placeholder="Digite sua senha.." type =      "password" required>
              <button type="button" id="toggle_password">
                  <i class="password-icon bi bi-eye-slash"></i>
              </button>
            </div>
            <button type = "submit" id="login_button">
              Login 
              <i class="bi bi-box-arrow-in-right"></i>
            </button> 
        </form>
    </section>    
</main>
@section Scripts {
    <script src="~/js/login.js"></script>
}