@model projeto_estoque_web.Models.view_models.DashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";

    var maiorVenda = Model.VendasUltimos7Dias.Count == 0
        ? 0m
        : Model.VendasUltimos7Dias.Max(venda => venda.Valor);
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard">

    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Visão geral da sua loja</p>
        </div>
    </div>

    <!-- Cards -->
    <div class="dashboard-cards">

        <div class="dashboard-card">
            <div class="card-icon">
                📦
            </div>

            <div>
                <span>Total de produtos</span>
                <strong>@Model.TotalProdutos</strong>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon alert">
                ⚠️
            </div>

            <div>
                <span>Estoque baixo</span>
                <strong>@Model.EstoqueBaixo</strong>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon">
                🛒
            </div>

            <div>
                <span>Pedidos pendentes</span>
                <strong>@Model.PedidosPendentes</strong>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon">
                💰
            </div>

            <div>
                <span>Vendas no mês</span>
                <strong>
                    @Model.VendasMes.ToString("C")
                </strong>
            </div>
        </div>

    </div>


    <!-- Conteúdo principal -->
    <div class="dashboard-grid">

        <!-- Vendas -->
        <div class="dashboard-panel sales-panel">

            <div class="panel-header">
                <div>
                    <h2>Vendas</h2>
                    <span>Últimos 7 dias</span>
                </div>
            </div>

            <div class="fake-chart">
                <div class="chart-line">
                    @foreach (var venda in Model.VendasUltimos7Dias)
                    {
                        var altura = venda.Valor <= 0 || maiorVenda <= 0
                            ? 0m
                            : Math.Max(2m, Math.Round(venda.Valor / maiorVenda * 100m));

                        <span style="height: @altura.ToString(CultureInfo.InvariantCulture)%"
                              title="@venda.Data.ToString("dd/MM") - @venda.Valor.ToString("C")"></span>
                    }
                </div>

                <div class="chart-days">
                    @foreach (var venda in Model.VendasUltimos7Dias)
                    {
                        <span>@venda.Data.ToString("dd/MM")</span>
                    }
                </div>
            </div>

        </div>


        <!-- Produtos mais vendidos -->
        <div class="dashboard-panel">

            <div class="panel-header">
                <div>
                    <h2>Produtos mais vendidos</h2>
                    <span>Este mês</span>
                </div>
            </div>

            @if (Model.ProdutosMaisVendidos.Count == 0)
            {
                <p class="empty-state">Nenhuma venda registrada neste mês.</p>
            }
            else
            {
                <div class="best-products">

                    @foreach (var produto in Model.ProdutosMaisVendidos)
                    {
                        <div class="best-product">

                            <div class="product-icon">
                                📦
                            </div>

                            <div class="product-info">
                                <strong>@produto.Nome</strong>
                                <span>@produto.QuantidadeVendida unidades</span>
                            </div>

                        </div>
                    }

                </div>
            }

        </div>

    </div>


    <!-- Promoções ativas -->
    <div class="dashboard-panel orders-panel">

        <div class="panel-header">
            <div>
                <h2>Promoções ativas</h2>
                <span>
                    @Model.PromocoesAtivas promoção(ões) · @Model.ProdutosEmPromocao produto(s) ·
                    economia de @Model.EconomiaPromocional.ToString("C") por unidade
                </span>
            </div>

            <a asp-controller="Promocoes"
               asp-action="Index"
               class="view-all">
                Ver todas
            </a>
        </div>

        @if (Model.ItensEmPromocao.Count == 0)
        {
            <p class="empty-state">Nenhuma promoção ativa no momento.</p>
        }
        else
        {

            <div class="table-container">

                <table>

                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Promoção</th>
                            <th>Desconto</th>
                            <th>Preço de tabela</th>
                            <th>Preço promocional</th>
                            <th>Economia</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ItensEmPromocao)
                        {
                            <tr>
                                <td class="produto-nome">
                                    @item.NomeProduto
                                </td>

                                <td>
                                    @item.NomePromocao
                                </td>

                                <td>
                                    <span class="desconto-tag">-@item.DescontoPercentual.ToString("N2")%</span>
                                </td>

                                <td class="preco-tabela">
                                    @item.PrecoTabela.ToString("C")
                                </td>

                                <td class="preco-promo">
                                    @item.PrecoPromocional.ToString("C")
                                </td>

                                <td class="preco-promo">
                                    @item.Economia.ToString("C")
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        }

    </div>


    <!-- Últimos pedidos -->
    <div class="dashboard-panel orders-panel">

        <div class="panel-header">
            <div>
                <h2>Últimos pedidos</h2>
                <span>Pedidos realizados recentemente</span>
            </div>

            <a asp-controller="Pedidos"
               asp-action="Index"
               class="view-all">
                Ver todos
            </a>
        </div>


        @if (Model.UltimosPedidos.Count == 0)
        {
            <p class="empty-state">Nenhum pedido registrado ainda.</p>
        }
        else
        {
            <div class="table-container">

                <table>

                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Data</th>
                            <th>Valor</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var pedido in Model.UltimosPedidos)
                        {
                            <tr>
                                <td>#@pedido.Id</td>

                                <td>
                                    @pedido.Data.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @pedido.Valor.ToString("C")
                                </td>

                                <td>
                                    <span class="status @pedido.StatusClasse">
                                        @pedido.Status
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>