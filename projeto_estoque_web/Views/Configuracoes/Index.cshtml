@model projeto_estoque_web.Models.view_models.ConfiguracoesViewModel

@{
    ViewData["Title"] = "Configurações";

    var cidadeUf = string.Join("/", new[] { Model.Resumo.Cidade, Model.Resumo.Uf }
        .Where(valor => !string.IsNullOrWhiteSpace(valor)));
}

@section Styles {
    <link rel="stylesheet" href="~/css/configuracoes.css" asp-append-version="true" />
}

<div class="configuracoes">

    <div class="configuracoes-header">
        <h1>Configurações</h1>
        <p>Dados da empresa</p>
    </div>

    <div class="configuracoes-cards">

        <div class="configuracoes-card">
            <div class="card-icon@(Model.Completo ? "" : " alert")">@(Model.Completo ? "✅" : "⚠️")</div>
            <div>
                <span>@(Model.Completo ? "Completo" : "Incompleto")</span>
                <strong>@Model.CamposPreenchidos/@Model.TotalCampos</strong>
            </div>
        </div>

        <div class="configuracoes-card">
            <div class="card-icon">🏢</div>
            <div>
                <span>Empresa</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Resumo.Nome) ? "—" : Model.Resumo.Nome)</strong>
            </div>
        </div>

        <div class="configuracoes-card">
            <div class="card-icon">📋</div>
            <div>
                <span>CNPJ</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Resumo.Cnpj) ? "—" : Model.Resumo.Cnpj)</strong>
            </div>
        </div>

        <div class="configuracoes-card">
            <div class="card-icon">📍</div>
            <div>
                <span>Cidade/UF</span>
                <strong>@(string.IsNullOrWhiteSpace(cidadeUf) ? "—" : cidadeUf)</strong>
            </div>
        </div>

    </div>

    @if (Model.DadosDeExemplo)
    {
        <div class="alert alert-info">
            ⚠️ Nenhum dado da empresa foi cadastrado ainda. Preencha o formulário abaixo para começar.
        </div>
    }

    @if (TempData["Mensagem"] != null)
    {
        <div class="alert alert-ok">@TempData["Mensagem"]</div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-erro">@TempData["Erro"]</div>
    }

    <div class="configuracoes-panel">

        <div class="panel-header">
            <div>
                <h2>Dados da empresa</h2>
                <span>Informações de identificação da empresa</span>
            </div>
        </div>

        <form asp-action="Index" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Dados.Nome"></label>
                    <input asp-for="Dados.Nome" placeholder="Ex.: Minha Empresa" />
                    <span asp-validation-for="Dados.Nome" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Dados.Cnpj"></label>
                    <input asp-for="Dados.Cnpj" maxlength="18" placeholder="Ex.: 00.000.000/0000-00" />
                    <span asp-validation-for="Dados.Cnpj" class="text-danger"></span>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Dados.Cep"></label>
                    <input asp-for="Dados.Cep" maxlength="9" placeholder="Ex.: 00000-000" />
                    <span asp-validation-for="Dados.Cep" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Dados.Endereco"></label>
                    <input asp-for="Dados.Endereco" placeholder="Ex.: Rua Exemplo, 123" />
                    <span asp-validation-for="Dados.Endereco" class="text-danger"></span>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Dados.Cidade"></label>
                    <input asp-for="Dados.Cidade" placeholder="Ex.: São Paulo" />
                    <span asp-validation-for="Dados.Cidade" class="text-danger"></span>
                </div>

                <div class="form-group form-uf">
                    <label asp-for="Dados.Uf"></label>
                    <input asp-for="Dados.Uf" maxlength="2" placeholder="UF" />
                    <span asp-validation-for="Dados.Uf" class="text-danger"></span>
                </div>

            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Dados.Telefone"></label>
                    <input asp-for="Dados.Telefone" maxlength="15" placeholder="Ex.: (11) 99999-9999" />
                    <span asp-validation-for="Dados.Telefone" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Dados.Email"></label>
                    <input asp-for="Dados.Email" placeholder="Ex.: contato@empresa.com.br" />
                    <span asp-validation-for="Dados.Email" class="text-danger"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="btn-salvar">Salvar alterações</button>
                <a asp-action="Index" class="btn-cancelar">Cancelar</a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/configuracoes.js" asp-append-version="true"></script>
}
