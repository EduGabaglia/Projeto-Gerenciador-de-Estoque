
@model projeto_estoque_web.Models.Produto
@using Microsoft.AspNetCore.Mvc.Rendering

<input asp-for="Id" type="hidden" />

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-group">
    <label asp-for="Nome">Nome do produto</label>

    <input asp-for="Nome"
           class="form-control"
           placeholder="Ex.: Arroz 5kg" />

    <span asp-validation-for="Nome"
          class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CategoriaId">Categoria</label>

    <select asp-for="CategoriaId"
            asp-items="@(ViewBag.Categorias as SelectList)"
            class="form-control">

        <option value="0">Selecione uma categoria</option>

    </select>

    <span asp-validation-for="CategoriaId"
          class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="LocalizacaoId">
        Localização no Galpão
    </label>

    <select asp-for="LocalizacaoId"
            asp-items="ViewBag.Localizacoes"
            class="form-control">

        <option value="">Selecione uma localização</option>

    </select>

    <span asp-validation-for="LocalizacaoId"
          class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Descricao">Descrição</label>

    <textarea asp-for="Descricao"
              class="form-control"
              rows="3"
              placeholder="Descrição do produto"></textarea>

    <span asp-validation-for="Descricao"
          class="text-danger"></span>
</div>

<div class="form-row">
    <div class="form-group">
        <label asp-for="Preco">Preço</label>

        <input asp-for="Preco"
               class="form-control"
               type="number"
               step="0.01"
               min="0.01" />

        <span asp-validation-for="Preco"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quantidade">Quantidade</label>

        <input asp-for="Quantidade"
               class="form-control"
               type="number"
               min="0" />

        <span asp-validation-for="Quantidade"
              class="text-danger"></span>
    </div>
</div>

<div class="form-actions">
    <button type="submit" class="btn-salvar">
        Salvar
    </button>

    <a asp-action="Index" class="btn-cancelar">
        Cancelar
    </a>
</div>
