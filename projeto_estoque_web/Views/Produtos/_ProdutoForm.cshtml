@model projeto_estoque_web.Models.Produto

<input asp-for="Id" type="hidden" />
@{
    var retorno = ViewBag.Retorno as string;
}
<input type="hidden" name="retorno" value="@retorno" />

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="form-group">
    <label asp-for="Nome"></label>
    <input asp-for="Nome" class="form-control" placeholder="Ex: Arroz 5kg" />
    <span asp-validation-for="Nome" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="Descricao"></label>
    <textarea asp-for="Descricao" class="form-control" rows="2" placeholder="Descrição opcional do produto"></textarea>
    <span asp-validation-for="Descricao" class="text-danger"></span>
</div>

<div class="form-group">
    <label asp-for="CategoriaId"></label>
    <select asp-for="CategoriaId" asp-items="@(ViewBag.Categorias as SelectList)" class="form-control">
        <option value="">Selecione uma categoria</option>
    </select>
    <span asp-validation-for="CategoriaId" class="text-danger"></span>
</div>

<div class="form-row">
    <div class="form-group">
        <label asp-for="Preco"></label>
        <input asp-for="Preco" class="form-control" />
        <span asp-validation-for="Preco" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quantidade"></label>
        <input asp-for="Quantidade" class="form-control" />
        <span asp-validation-for="Quantidade" class="text-danger"></span>
    </div>
</div>

<div class="form-group">
    <label asp-for="LocalizacaoId"></label>
    <select asp-for="LocalizacaoId" asp-items="@(ViewBag.Localizacoes as SelectList)" class="form-control">
        <option value="">Sem localização</option>
    </select>
    <span asp-validation-for="LocalizacaoId" class="text-danger"></span>
</div>


<div class="form-actions">
    <button type="submit" class="btn-salvar">
        Salvar
    </button>

    @if (retorno == "estoque")
    {
        <a asp-controller="Estoque" asp-action="Index" class="btn-cancelar">
            Cancelar
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn-cancelar">
            Cancelar
        </a>
    }
</div>
