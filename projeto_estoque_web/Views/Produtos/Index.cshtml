@model projeto_estoque_web.Models.view_models.ProdutosViewModel

@{
    ViewData["Title"] = "Produtos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/produtos.css" asp-append-version="true" />
}

<div class="produtos">

    <div class="produtos-header">
        <div>
            <h1>Produtos</h1>
            <p>Cadastro e controle de produtos</p>
        </div>

        <a asp-action="Criar" class="btn-novo">
            + Novo produto
        </a>
    </div>

    @if (TempData["Mensagem"] != null)
    {
        <div class="alert-ok">
            @TempData["Mensagem"]
        </div>
    }

    <!-- Cards -->
    <div class="produtos-cards">

        <div class="produtos-card">
            <div class="card-icon">
                📦
            </div>

            <div>
                <span>Total de produtos</span>
                <strong>@Model.TotalProdutos</strong>
            </div>
        </div>

        <div class="produtos-card">
            <div class="card-icon alert">
                ⚠️
            </div>

            <div>
                <span>Estoque baixo</span>
                <strong>@Model.EstoqueBaixo</strong>
            </div>
        </div>

        <div class="produtos-card">
            <div class="card-icon">
                🗂️
            </div>

            <div>
                <span>Categorias</span>
                <strong>@Model.CategoriasCadastradas</strong>
            </div>
        </div>

        <div class="produtos-card">
            <div class="card-icon">
                💰
            </div>

            <div>
                <span>Valor em estoque</span>
                <strong>
                    @Model.ValorTotalEstoque.ToString("C")
                </strong>
            </div>
        </div>

    </div>

    <!-- Lista de produtos -->
    <div class="produtos-panel">

        <div class="panel-header">
            <div>
                <h2>Lista de produtos</h2>
                <span>@Model.TotalProdutos produtos cadastrados</span>
            </div>

            <form method="get" asp-action="Index" class="search-form">
                <input type="text"
                       name="busca"
                       value="@Model.Busca"
                       placeholder="Buscar por nome ou categoria" />

                <button type="submit" class="btn-buscar">
                    Buscar
                </button>
            </form>
        </div>

        @if (Model.Produtos.Count == 0)
        {
            <p class="empty-state">Nenhum produto encontrado.</p>
        }
        else
        {
            <div class="table-container">

                <table>

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nome</th>
                            <th>Categoria</th>
                            <th>Preço</th>
                            <th>Estoque</th>
                            <th>Status</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var produto in Model.Produtos)
                        {
                            <tr>
                                <td>#@produto.Id</td>

                                <td class="produto-nome">
                                    @produto.Nome
                                </td>

                                <td>
                                    @produto.Categoria
                                </td>

                                <td>
                                    @produto.Preco.ToString("C")
                                </td>

                                <td>
                                    @produto.Quantidade
                                </td>

                                <td>
                                    <span class="status @produto.StatusClasse">
                                        @produto.Status
                                    </span>
                                </td>

                                <td>
                                    <div class="acoes">
                                        <a asp-action="Editar"
                                           asp-route-id="@produto.Id"
                                           class="btn-acoes editar">
                                            Editar
                                        </a>

                                        <form asp-action="Excluir"
                                              asp-route-id="@produto.Id"
                                              method="post"
                                              class="form-excluir"
                                              onsubmit="return confirm('Excluir este produto?');">
                                            <button type="submit"
                                                    class="btn-acoes excluir">
                                                Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- Paginação -->
            @if (Model.TotalPaginas > 1)
            {
                <div class="produtos-paginacao">

                    <a asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-pagina="@(Model.PaginaAtual - 1)"
                       class="page-btn @(Model.PaginaAtual == 1 ? "disabled" : "")">
                        ‹ Anterior
                    </a>

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <a asp-action="Index"
                           asp-route-busca="@Model.Busca"
                           asp-route-pagina="@i"
                           class="page-btn @(i == Model.PaginaAtual ? "active" : "")">
                            @i
                        </a>
                    }

                    <a asp-action="Index"
                       asp-route-busca="@Model.Busca"
                       asp-route-pagina="@(Model.PaginaAtual + 1)"
                       class="page-btn @(Model.PaginaAtual == Model.TotalPaginas ? "disabled" : "")">
                        Próxima ›
                    </a>

                </div>
            }

        }

    </div>

</div>