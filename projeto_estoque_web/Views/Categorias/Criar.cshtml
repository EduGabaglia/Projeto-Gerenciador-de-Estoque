@model projeto_estoque_web.Models.Categoria

@{
    ViewData["Title"] = "Nova categoria";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categorias.css" asp-append-version="true" />
}

<div class="categorias">

    <div class="categorias-header">
        <div>
            <h1>Nova categoria</h1>
            <p>Preencha os dados para cadastrar uma nova categoria</p>
        </div>
    </div>

    <form asp-action="Criar" method="post">

        <div class="categorias-panel">
            <partial name="_CategoriaForm" model="Model" />
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}