{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // As credenciais NÃO ficam neste arquivo (ele vai para o Git).
    // Configure a conexão com o banco de uma das formas:
    //   dotnet user-secrets set "ConnectionStrings:EstoqueDb" "<connection string>"
    //   variável de ambiente ConnectionStrings__EstoqueDb
    "EstoqueDb": ""
  },
  "Jwt": {
    // A chave também NÃO fica neste arquivo. Configure com:
    //   dotnet user-secrets set "Jwt:Key" "<chave com pelo menos 32 bytes>"
    //   variável de ambiente Jwt__Key
    "Key": "",
    "Issuer": "projeto_estoque_api",
    "Audience": "projeto_estoque_mobile",
    "ExpiraEmDias": 7
  }
}
